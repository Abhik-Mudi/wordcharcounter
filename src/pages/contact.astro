---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Contact Us | Word & Character Counter"
	description="Have a question or feedback? Contact the Word & Character Counter team."
>
	<main class="max-w-4xl mx-auto px-4 py-20 w-full">
		<header class="mb-16 text-center">
			<h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">Contact Us</h1>
			<p class="text-slate-600 dark:text-slate-400 text-lg">We'd love to hear from you. Send us a message below.</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-12 gap-12">
			<!-- Contact Form Placeholder -->
			<div class="md:col-span-8">
				<form class="space-y-6 bg-slate-50 dark:bg-slate-800/30 p-8 rounded-2xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						<div class="space-y-2">
							<label for="name" class="text-sm font-medium text-slate-600 dark:text-slate-300">Name</label>
							<input 
								type="text" 
								id="name" 
								class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all"
								placeholder="Your Name"
							/>
						</div>
						<div class="space-y-2">
							<label for="email" class="text-sm font-medium text-slate-600 dark:text-slate-300">Email</label>
							<input 
								type="email" 
								id="email" 
								class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all"
								placeholder="your@email.com"
							/>
						</div>
					</div>
					<div class="space-y-2">
						<label for="subject" class="text-sm font-medium text-slate-600 dark:text-slate-300">Subject</label>
						<select 
							id="subject" 
							class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all appearance-none"
						>
							<option>General Inquiry</option>
							<option>Bug Report</option>
							<option>Feature Request</option>
							<option>Business Collaboration</option>
						</select>
					</div>
					<div class="space-y-2">
						<label for="message" class="text-sm font-medium text-slate-600 dark:text-slate-300">Message</label>
						<textarea 
							id="message" 
							rows="5"
							class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all resize-none"
							placeholder="How can we help?"
						></textarea>
					</div>
					<button 
						type="button"
						class="w-full py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg transition-all shadow-lg shadow-blue-600/20"
					>
						Send Message
					</button>
				</form>
			</div>

			<!-- Info Sidebar -->
			<div class="md:col-span-4 space-y-8">
				<div class="space-y-4">
					<h3 class="text-lg font-bold text-slate-900 dark:text-white">Get in Touch</h3>
					<div class="flex items-start gap-3 text-slate-600 dark:text-slate-400">
						<svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500 dark:text-blue-400 mt-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
						<div>
							<p class="font-medium text-slate-900 dark:text-slate-200">Email Us</p>
							<p class="text-sm">support@wordcharactercounter.com</p>
						</div>
					</div>
				</div>

				<div class="space-y-4">
					<h3 class="text-lg font-bold text-slate-900 dark:text-white">Hours of Operation</h3>
					<p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
						Our team monitors inquiries Monday through Friday, 9:00 AM – 5:00 PM EST. We typically respond within 24-48 business hours.
					</p>
				</div>

				<div class="p-6 bg-blue-500/5 border border-blue-500/10 rounded-2xl shadow-sm">
					<h4 class="text-blue-600 dark:text-blue-400 font-bold text-sm mb-2">Need a fast fix?</h4>
					<p class="text-slate-500 dark:text-slate-500 text-xs leading-relaxed">
						Check our <a href="/#faq" class="text-blue-600 dark:text-blue-400/80 hover:underline">FAQ section</a> for instant answers to the most common questions.
					</p>
				</div>
			</div>
		</div>
	</main>
</Layout>
