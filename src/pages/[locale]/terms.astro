---
import Layout from '../../layouts/Layout.astro';
import TermsPage from '../../components/TermsPage.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { locale: 'de' } },
    { params: { locale: 'fr' } },
    { params: { locale: 'es' } },
    { params: { locale: 'pt' } },
    { params: { locale: 'nl' } },
  ];
}

const { locale } = Astro.params;
const t = useTranslations(locale);
---

<Layout title={t('terms.metaTitle')} description={t('terms.metaDesc')}>
  <TermsPage lang={locale} />
</Layout>
