---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="max-w-6xl mx-auto px-4 py-12 w-full">
		<header class="mb-10 text-center">
			<h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4 pb-3 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-emerald-600 dark:from-blue-400 dark:to-emerald-400">
				Word & Character Counter - Accurate Writing Analysis
			</h1>
			<p class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">
				Analyze your text instantly. Get precise metrics for words, characters, readability, and SEO keyword density as you type.
			</p>
		</header>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
			<!-- Text Input Area -->
			<section class="lg:col-span-8 space-y-4">
				<div class="space-y-4 mb-2">
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
						<label for="text-input" class="text-sm font-medium text-slate-600 dark:text-slate-300">Target Platform (Optional):</label>
						<div class="flex gap-2 overflow-x-auto pb-2 sm:pb-0 no-scrollbar">
							<button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-blue-600 text-white shadow-sm transition-all whitespace-nowrap" data-limit="0">None</button>
							<button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="280">Twitter / X</button>
							<button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="3000">LinkedIn</button>
							<button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="2200">Instagram</button>
							<button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="60">SEO Title</button>
							<button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="160">SEO Meta</button>
						</div>
					</div>

					<!-- Progress Bar Container -->
					<div id="progress-container" class="hidden space-y-2 animate-in fade-in slide-in-from-top-2 duration-300">
						<div class="flex justify-between items-end">
							<div class="flex items-center gap-2">
								<span id="platform-name" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Twitter</span>
								<span id="limit-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Good</span>
							</div>
							<span class="text-xs font-mono text-slate-500 dark:text-slate-400">
								<span id="current-char-count">0</span> / <span id="max-char-limit">280</span>
							</span>
						</div>
						<div class="h-2 w-full bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner">
							<div id="progress-bar" class="h-full bg-blue-500 transition-all duration-300 ease-out" style="width: 0%"></div>
						</div>
					</div>

					<div class="flex justify-between items-center">
						<span class="text-xs text-slate-400 dark:text-slate-500">Your content:</span>
						<div class="flex gap-2">
							<button 
								id="copy-btn"
								class="px-3 py-1.5 text-xs font-semibold rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors flex items-center gap-1 shadow-sm"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
								Copy Text
							</button>
							<button 
								id="clear-btn"
								class="px-3 py-1.5 text-xs font-semibold rounded bg-rose-50 dark:bg-rose-500/10 hover:bg-rose-100 dark:hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-100 dark:border-rose-500/20 transition-colors flex items-center gap-1 shadow-sm"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
								Clear
							</button>
						</div>
					</div>
				</div>
				<textarea
					id="text-input"
					class="w-full h-96 p-6 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-800 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner resize-none transition-all outline-none"
					placeholder="Start typing or paste your content here..."
				></textarea>
			</section>

			<!-- Metrics Sidebar -->
			<aside class="lg:col-span-4 space-y-6">
				<!-- Primary Metrics Grid -->
				<div class="grid grid-cols-2 gap-4">
					<div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
						<span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">Words</span>
						<span id="word-count" class="text-3xl font-bold text-blue-600 dark:text-blue-400">0</span>
					</div>
					<div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
						<span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">Characters</span>
						<span id="char-count" class="text-3xl font-bold text-emerald-600 dark:text-emerald-400">0</span>
					</div>
					<div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
						<span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">Sentences</span>
						<span id="sentence-count" class="text-2xl font-bold text-slate-700 dark:text-slate-200">0</span>
					</div>
					<div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
						<span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">Paragraphs</span>
						<span id="paragraph-count" class="text-2xl font-bold text-slate-700 dark:text-slate-200">0</span>
					</div>
					<div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50 col-span-2">
						<span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">Unique Characters</span>
						<span id="unique-char-count" class="text-2xl font-bold text-purple-600 dark:text-purple-400">0</span>
					</div>
				</div>

				<!-- Detailed Metrics -->
				<div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700 space-y-4 shadow-sm">
					<div class="flex justify-between items-center text-sm">
						<span class="text-slate-500 dark:text-slate-400">Chars (no spaces)</span>
						<span id="char-no-spaces" class="font-mono text-slate-700 dark:text-slate-200">0</span>
					</div>
					<div class="flex justify-between items-center text-sm border-t border-slate-200 dark:border-slate-700/50 pt-4">
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500 dark:text-blue-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
							<span class="text-slate-500 dark:text-slate-400">Reading Time</span>
						</div>
						<span id="reading-time" class="text-slate-700 dark:text-slate-200 font-medium">0s</span>
					</div>
					<div class="flex justify-between items-center text-sm border-t border-slate-200 dark:border-slate-700/50 pt-4">
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="text-emerald-500 dark:text-emerald-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 18.5a6.66 6.66 0 0 1-3.5-1.03 6.67 6.67 0 0 1-3.5 1.03"/><path d="M19 18.5a6.66 6.66 0 0 0-3.5-1.03 6.67 6.67 0 0 0-3.5 1.03"/><path d="M12 21V12"/><path d="m16 9-4 4-4-4"/></svg>
							<span class="text-slate-500 dark:text-slate-400">Speaking Time</span>
						</div>
						<span id="speaking-time" class="text-slate-700 dark:text-slate-200 font-medium">0s</span>
					</div>
				</div>

				<!-- Keyword Density Panel -->
				<div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
					<h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 uppercase tracking-widest mb-4">Top Keywords</h3>
					<div id="keyword-list" class="space-y-3">
						<p class="text-xs text-slate-400 dark:text-slate-500 italic">Enter text to see keyword analysis...</p>
					</div>
				</div>

				<!-- Character Frequency Panel -->
				<div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
					<h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 uppercase tracking-widest mb-4">Character Frequency</h3>
					<div id="char-freq-list" class="grid grid-cols-4 gap-2">
						<p class="text-xs text-slate-400 dark:text-slate-500 italic col-span-full">Enter text to see frequency...</p>
					</div>
				</div>
			</aside>
		</div>

		<!-- Quick Reference Section -->
		<section id="guidelines" class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
			<div class="bg-slate-50 dark:bg-slate-800/20 p-6 rounded-xl border border-slate-200 dark:border-slate-700/30 shadow-sm">
				<div class="flex items-center gap-2 mb-3">
					<svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500 dark:text-blue-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
					<h3 class="text-slate-700 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">Social Media</h3>
				</div>
				<ul class="text-sm text-slate-500 dark:text-slate-400 space-y-2">
					<li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>Twitter/X</span> <span class="text-slate-700 dark:text-slate-200 font-mono">280 Chars</span></li>
					<li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>LinkedIn Post</span> <span class="text-slate-700 dark:text-slate-200 font-mono">3,000 Chars</span></li>
					<li class="flex justify-between"><span>Instagram Caption</span> <span class="text-slate-700 dark:text-slate-200 font-mono">2,200 Chars</span></li>
				</ul>
			</div>
			<div class="bg-slate-50 dark:bg-slate-800/20 p-6 rounded-xl border border-slate-200 dark:border-slate-700/30 shadow-sm">
				<div class="flex items-center gap-2 mb-3">
					<svg xmlns="http://www.w3.org/2000/svg" class="text-emerald-500 dark:text-emerald-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5z"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M8 7h6"/><path d="M8 11h8"/><path d="M8 15h6"/></svg>
					<h3 class="text-slate-700 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">Content Writing</h3>
				</div>
				<ul class="text-sm text-slate-500 dark:text-slate-400 space-y-2">
					<li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>Short Blog</span> <span class="text-slate-700 dark:text-slate-200 font-mono">600 - 1k Words</span></li>
					<li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>Long Form</span> <span class="text-slate-700 dark:text-slate-200 font-mono">1.5k - 2.5k Words</span></li>
					<li class="flex justify-between"><span>SEO Title</span> <span class="text-slate-700 dark:text-slate-200 font-mono">50 - 60 Chars</span></li>
				</ul>
			</div>
			<div class="bg-slate-50 dark:bg-slate-800/20 p-6 rounded-xl border border-slate-200 dark:border-slate-700/30 shadow-sm">
				<div class="flex items-center gap-2 mb-3">
					<svg xmlns="http://www.w3.org/2000/svg" class="text-purple-500 dark:text-purple-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
					<h3 class="text-slate-700 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">Academic</h3>
				</div>
				<ul class="text-sm text-slate-500 dark:text-slate-400 space-y-2">
					<li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>Standard Essay</span> <span class="text-slate-700 dark:text-slate-200 font-mono">500 - 2k Words</span></li>
					<li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>Dissertation</span> <span class="text-slate-700 dark:text-slate-200 font-mono">10k+ Words</span></li>
					<li class="flex justify-between"><span>Abstract</span> <span class="text-slate-700 dark:text-slate-200 font-mono">150 - 250 Words</span></li>
				</ul>
			</div>
		</section>

		<!-- Product Overview Section -->
		<section id="features" class="mt-24 py-12 border-y border-slate-200 dark:border-slate-800/50">
			<div class="max-w-4xl mx-auto text-center px-4">
				<h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6">Professional Text Analysis for Everyone</h2>
				<p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed mb-12">
					Our Word & Character Counter is more than just a simple character counter. It's a comprehensive writing assistant designed to help you optimize your content for SEO, academic standards, and social media engagement. Whether you're a professional copywriter or a student, our tool provides the insights you need to write with confidence.
				</p>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-left">
					<div class="space-y-3">
						<div class="w-12 h-12 rounded-2xl bg-blue-500/10 dark:bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
						</div>
						<h4 class="text-slate-900 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">Instant Feedback</h4>
						<p class="text-slate-500 dark:text-slate-500 text-sm leading-relaxed">Experience zero-latency analysis. Every word, character, and keyword is tracked in real-time as you type.</p>
					</div>
					<div class="space-y-3">
						<div class="w-12 h-12 rounded-2xl bg-emerald-500/10 dark:bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
						</div>
						<h4 class="text-slate-900 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">100% Private</h4>
						<p class="text-slate-500 dark:text-slate-500 text-sm leading-relaxed">Your data is yours. All calculations are performed locally in your browser; your text is never sent to a server.</p>
					</div>
					<div class="space-y-3">
						<div class="w-12 h-12 rounded-2xl bg-purple-500/10 dark:bg-purple-500/10 flex items-center justify-center text-purple-600 dark:text-purple-400">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
						</div>
						<h4 class="text-slate-900 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">Global Standards</h4>
						<p class="text-slate-500 dark:text-slate-500 text-sm leading-relaxed">Stay compliant with platform-specific limits for SEO, social media, and international academic formats.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- FAQ Section -->
		<section id="faq" class="mt-20 pt-12 border-t border-slate-200 dark:border-slate-800 max-w-4xl mx-auto">
			<h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8 text-center">Frequently Asked Questions</h2>
			<div class="space-y-6">
				<div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
					<h3 class="text-lg font-semibold text-blue-600 dark:text-blue-400 mb-2">Is Word & Character Counter free to use?</h3>
					<p class="text-slate-600 dark:text-slate-400 leading-relaxed">
						Yes, our <strong>Word & Character Counter</strong> is 100% free to use. There are no hidden fees, subscriptions, or limits on how much text you can analyze. It's built for writers who need a reliable <strong>free word counter</strong>.
					</p>
				</div>
				<div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
					<h3 class="text-lg font-semibold text-emerald-600 dark:text-emerald-400 mb-2">Is my data safe? Does the tool store my text?</h3>
					<p class="text-slate-600 dark:text-slate-400 leading-relaxed">
						Your privacy is our priority. All calculations and text analysis are performed locally within your web browser. We never send your text to any server, and we do not store any of your content.
					</p>
				</div>
				<div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
					<h3 class="text-lg font-semibold text-purple-600 dark:text-purple-400 mb-2">How does the Twitter (X) character counter work?</h3>
					<p class="text-slate-600 dark:text-slate-400 leading-relaxed">
						Our tool functions as a real-time <strong>twitter character counter</strong>. Since X (Twitter) has a 280-character limit, you can monitor your character count as you type to ensure your post fits perfectly without being truncated.
					</p>
				</div>
				<div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
					<h3 class="text-lg font-semibold text-blue-600 dark:text-blue-400 mb-2">Can I use this as an essay word counter?</h3>
					<p class="text-slate-600 dark:text-slate-400 leading-relaxed">
						Absolutely. It is an ideal <strong>essay word counter</strong> for students and academics. It provides accurate word counts, character counts (with and without spaces), and sentence tracking to help you meet strict assignment requirements.
					</p>
				</div>
				<div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
					<h3 class="text-lg font-semibold text-emerald-600 dark:text-emerald-400 mb-2">How is keyword density calculated?</h3>
					<p class="text-slate-600 dark:text-slate-400 leading-relaxed">
						Keyword density is calculated by dividing the number of times a specific word appears by the total number of words in the text. We filter out common "stop words" to show you the most meaningful keywords for SEO.
					</p>
				</div>
				<div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
