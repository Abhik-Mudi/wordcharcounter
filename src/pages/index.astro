---
import Layout from '../layouts/Layout.astro';
import CounterPage from '../components/CounterPage.astro';
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang);
---

<Layout title={t('counter.metaTitle')} description={t('counter.metaDesc')}>
  <CounterPage lang={lang} />
</Layout>
