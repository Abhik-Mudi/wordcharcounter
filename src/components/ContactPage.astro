---
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<main class="max-w-4xl mx-auto px-4 py-20 w-full">
  <header class="mb-16 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">{t('contact.title')}</h1>
    <p class="text-slate-600 dark:text-slate-400 text-lg">{t('contact.subtitle')}</p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
    <!-- Contact Form Placeholder -->
    <div class="md:col-span-8">
      <form class="space-y-6 bg-slate-50 dark:bg-slate-800/30 p-8 rounded-2xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="name" class="text-sm font-medium text-slate-600 dark:text-slate-300">{t('contact.form.name')}</label>
            <input 
              type="text" 
              id="name" 
              class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all"
              placeholder={t('contact.form.namePlaceholder')}
            />
          </div>
          <div class="space-y-2">
            <label for="email" class="text-sm font-medium text-slate-600 dark:text-slate-300">{t('contact.form.email')}</label>
            <input 
              type="email" 
              id="email" 
              class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all"
              placeholder={t('contact.form.emailPlaceholder')}
            />
          </div>
        </div>
        <div class="space-y-2">
          <label for="subject" class="text-sm font-medium text-slate-600 dark:text-slate-300">{t('contact.form.subject')}</label>
          <select 
            id="subject" 
            class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all appearance-none"
          >
            <option>{t('contact.form.subject.general')}</option>
            <option>{t('contact.form.subject.bug')}</option>
            <option>{t('contact.form.subject.feature')}</option>
            <option>{t('contact.form.subject.business')}</option>
          </select>
        </div>
        <div class="space-y-2">
          <label for="message" class="text-sm font-medium text-slate-600 dark:text-slate-300">{t('contact.form.message')}</label>
          <textarea 
            id="message" 
            rows="5"
            class="w-full p-3 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-slate-900 dark:text-slate-200 transition-all resize-none"
            placeholder={t('contact.form.messagePlaceholder')}
          ></textarea>
        </div>
        <button 
          type="button"
          class="w-full py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg transition-all shadow-lg shadow-blue-600/20"
        >
          {t('contact.form.submit')}
        </button>
      </form>
    </div>

    <!-- Info Sidebar -->
    <div class="md:col-span-4 space-y-8">
      <div class="space-y-4">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">{t('contact.sidebar.title')}</h3>
        <div class="flex items-start gap-3 text-slate-600 dark:text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500 dark:text-blue-400 mt-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <div>
            <p class="font-medium text-slate-900 dark:text-slate-200">{t('contact.sidebar.emailTitle')}</p>
            <p class="text-sm">support@wordcharactercounter.com</p>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">{t('contact.sidebar.hoursTitle')}</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
          {t('contact.sidebar.hoursDesc')}
        </p>
      </div>

      <div class="p-6 bg-blue-500/5 border border-blue-500/10 rounded-2xl shadow-sm">
        <h4 class="text-blue-600 dark:text-blue-400 font-bold text-sm mb-2">{t('contact.sidebar.helpTitle')}</h4>
        <p class="text-slate-500 dark:text-slate-500 text-xs leading-relaxed">
          {lang === 'en' && <>Check our <a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="text-blue-600 dark:text-blue-400/80 hover:underline">FAQ section</a> for instant answers to the most common questions.</>}
          {lang === 'de' && <>Besuchen Sie unseren <a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="text-blue-600 dark:text-blue-400/80 hover:underline">FAQ-Bereich</a> für sofortige Antworten auf die häufigsten Fragen.</>}
          {lang === 'fr' && <>Consultez notre <a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="text-blue-600 dark:text-blue-400/80 hover:underline">section FAQ</a> pour obtenir des réponses instantanées aux questions récurrentes.</>}
          {lang === 'es' && <>Consulte nuestra <a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="text-blue-600 dark:text-blue-400/80 hover:underline">sección de preguntas frecuentes</a> para obtener respuestas instantáneas.</>}
          {lang === 'pt' && <>Consulte nossa <a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="text-blue-600 dark:text-blue-400/80 hover:underline">seção de perguntas frequentes</a> para obter respostas instantâneas.</>}
          {lang === 'nl' && <>Bekijk onze <a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="text-blue-600 dark:text-blue-400/80 hover:underline">FAQ-sectie</a> voor directe antwoorden op de meest voorkomende vragen.</>}
        </p>
      </div>
    </div>
  </div>
</main>
