    <!-- SEO Content Section -->
    <section class="mt-24 pb-32 border-t border-slate-200 dark:border-slate-800 pt-24 overflow-hidden">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-3xl mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6 leading-tight">
            {t('seo.title')}
          </h2>
          <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('seo.subtitle')}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Card 1 -->
          <div class="group p-8 bg-slate-50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-700/50 rounded-3xl hover:border-blue-500/50 dark:hover:border-blue-400/50 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/5">
            <div class="text-blue-600 dark:text-blue-400 font-mono text-xs font-bold uppercase tracking-widest mb-6 flex items-center gap-2">
              <span class="w-8 h-[1px] bg-current"></span>
              {t('seo.c1.tag')}
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {t('seo.c1.title')}
            </h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
              {t('seo.c1.desc')}
            </p>
          </div>

          <!-- Card 2 -->
          <div class="group p-8 bg-slate-50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-700/50 rounded-3xl hover:border-emerald-500/50 dark:hover:border-emerald-400/50 transition-all duration-300 hover:shadow-2xl hover:shadow-emerald-500/5">
            <div class="text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold uppercase tracking-widest mb-6 flex items-center gap-2">
              <span class="w-8 h-[1px] bg-current"></span>
              {t('seo.c2.tag')}
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {t('seo.c2.title')}
