---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="counter-container"
  data-copied={t('script.copiedSuccess')}
  data-enter-keywords={t('script.enterTextKeywords')}
  data-no-keywords={t('script.noKeywords')}
  data-enter-freq={t('script.enterTextFreq')}
  data-space={t('script.space')}
  data-over-limit={t('counter.limit.over')}
  data-warning={t('counter.limit.warning')}
  data-good={t('counter.limit.good')}
  data-lang={lang}
>
  <main class="max-w-6xl mx-auto px-4 py-12 w-full">
    <header class="mb-10 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4 pb-3 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-emerald-600 dark:from-blue-400 dark:to-emerald-400">
        {t('counter.title')}
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">
        {t('counter.subtitle')}
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Text Input Area -->
      <section class="lg:col-span-8 space-y-4">
        <div class="space-y-4 mb-2">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <label for="text-input" class="text-sm font-medium text-slate-600 dark:text-slate-300">
              {t('counter.targetPlatform')}
            </label>
            <div class="flex gap-2 overflow-x-auto pb-2 sm:pb-0 platform-scrollbar">
              <button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-blue-600 text-white shadow-sm transition-all whitespace-nowrap" data-limit="0">
                {t('counter.platform.none')}
              </button>
              <button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="280">
                {t('counter.platform.twitter')}
              </button>
              <button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="3000">
                {t('counter.platform.linkedin')}
              </button>
              <button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="2200">
                {t('counter.platform.instagram')}
              </button>
              <button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="60">
                {t('counter.platform.seoTitle')}
              </button>
              <button class="platform-btn px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all whitespace-nowrap" data-limit="160">
                {t('counter.platform.seoMeta')}
              </button>
            </div>
          </div>

          <!-- Progress Bar Container -->
          <div id="progress-container" class="hidden space-y-2 animate-in fade-in slide-in-from-top-2 duration-300">
            <div class="flex justify-between items-end">
              <div class="flex items-center gap-2">
                <span id="platform-name" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">None</span>
                <span id="limit-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Good</span>
              </div>
              <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
                <span id="current-char-count">0</span> / <span id="max-char-limit">0</span>
              </span>
            </div>
            <div class="h-2 w-full bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner">
              <div id="progress-bar" class="h-full bg-blue-500 transition-all duration-300 ease-out" style="width: 0%"></div>
            </div>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-xs text-slate-400 dark:text-slate-500">{t('counter.yourContent')}</span>
            <div class="flex gap-2">
              <button 
                id="copy-btn"
                class="px-3 py-1.5 text-xs font-semibold rounded bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors flex items-center gap-1 shadow-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <span>{t('counter.copy')}</span>
              </button>
              <button 
                id="clear-btn"
                class="px-3 py-1.5 text-xs font-semibold rounded bg-rose-50 dark:bg-rose-500/10 hover:bg-rose-100 dark:hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-100 dark:border-rose-500/20 transition-colors flex items-center gap-1 shadow-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                {t('counter.clear')}
              </button>
            </div>
          </div>
        </div>
        <textarea
          id="text-input"
          class="w-full h-96 p-6 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-800 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 shadow-inner resize-none transition-all outline-none"
          placeholder={t('counter.placeholder')}
        ></textarea>
      </section>

      <!-- Metrics Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Primary Metrics Grid -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
            <span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">
              {t('counter.words')}
            </span>
            <span id="word-count" class="text-3xl font-bold text-blue-600 dark:text-blue-400">0</span>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
            <span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">
              {t('counter.characters')}
            </span>
            <span id="char-count" class="text-3xl font-bold text-emerald-600 dark:text-emerald-400">0</span>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
            <span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">
              {t('counter.sentences')}
            </span>
            <span id="sentence-count" class="text-2xl font-bold text-slate-700 dark:text-slate-200">0</span>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50">
            <span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">
              {t('counter.paragraphs')}
            </span>
            <span id="paragraph-count" class="text-2xl font-bold text-slate-700 dark:text-slate-200">0</span>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800/40 p-4 rounded-lg border border-slate-200 dark:border-slate-700/50 col-span-2">
            <span class="block text-xs text-slate-400 dark:text-slate-500 uppercase font-bold tracking-wider mb-1">
              {t('counter.uniqueCharacters')}
            </span>
            <span id="unique-char-count" class="text-2xl font-bold text-purple-600 dark:text-purple-400">0</span>
          </div>
        </div>

        <!-- Detailed Metrics -->
        <div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700 space-y-4 shadow-sm">
          <div class="flex justify-between items-center text-sm">
            <span class="text-slate-500 dark:text-slate-400">{t('counter.charsNoSpaces')}</span>
            <span id="char-no-spaces" class="font-mono text-slate-700 dark:text-slate-200">0</span>
          </div>
          <div class="flex justify-between items-center text-sm border-t border-slate-200 dark:border-slate-700/50 pt-4">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500 dark:text-blue-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              <span class="text-slate-500 dark:text-slate-400">{t('counter.readingTime')}</span>
            </div>
            <span id="reading-time" class="text-slate-700 dark:text-slate-200 font-medium">0s</span>
          </div>
          <div class="flex justify-between items-center text-sm border-t border-slate-200 dark:border-slate-700/50 pt-4">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="text-emerald-500 dark:text-emerald-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 18.5a6.66 6.66 0 0 1-3.5-1.03 6.67 6.67 0 0 1-3.5 1.03"/><path d="M19 18.5a6.66 6.66 0 0 0-3.5-1.03 6.67 6.67 0 0 0-3.5 1.03"/><path d="M12 21V12"/><path d="m16 9-4 4-4-4"/></svg>
              <span class="text-slate-500 dark:text-slate-400">{t('counter.speakingTime')}</span>
            </div>
            <span id="speaking-time" class="text-slate-700 dark:text-slate-200 font-medium">0s</span>
          </div>
        </div>

        <!-- Keyword Density Panel -->
        <div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 uppercase tracking-widest mb-4">
            {t('counter.topKeywords')}
          </h3>
          <div id="keyword-list" class="space-y-3">
            <p class="text-xs text-slate-400 dark:text-slate-500 italic">{t('counter.enterTextKeywords')}</p>
          </div>
        </div>

        <!-- Character Frequency Panel -->
        <div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 uppercase tracking-widest mb-4">
            {t('counter.charFreq')}
          </h3>
          <div id="char-freq-list" class="grid grid-cols-4 gap-2">
            <p class="text-xs text-slate-400 dark:text-slate-500 italic col-span-full">{t('counter.enterTextFreq')}</p>
          </div>
        </div>
      </aside>
    </div>

    <!-- Quick Reference Section -->
    <section id="guidelines" class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-50 dark:bg-slate-800/20 p-6 rounded-xl border border-slate-200 dark:border-slate-700/30 shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="text-blue-500 dark:text-blue-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <h3 class="text-slate-700 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">{t('counter.socialMedia')}</h3>
        </div>
        <ul class="text-sm text-slate-500 dark:text-slate-400 space-y-2">
          <li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>Twitter/X</span> <span class="text-slate-700 dark:text-slate-200 font-mono">280 Chars</span></li>
          <li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>LinkedIn Post</span> <span class="text-slate-700 dark:text-slate-200 font-mono">3,000 Chars</span></li>
          <li class="flex justify-between"><span>Instagram Caption</span> <span class="text-slate-700 dark:text-slate-200 font-mono">2,200 Chars</span></li>
        </ul>
      </div>
      <div class="bg-slate-50 dark:bg-slate-800/20 p-6 rounded-xl border border-slate-200 dark:border-slate-700/30 shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="text-emerald-500 dark:text-emerald-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5z"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M8 7h6"/><path d="M8 11h8"/><path d="M8 15h6"/></svg>
          <h3 class="text-slate-700 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">{t('counter.contentWriting')}</h3>
        </div>
        <ul class="text-sm text-slate-500 dark:text-slate-400 space-y-2">
          <li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>{t('counter.shortBlog')}</span> <span class="text-slate-700 dark:text-slate-200 font-mono">600 - 1k Words</span></li>
          <li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>{t('counter.longForm')}</span> <span class="text-slate-700 dark:text-slate-200 font-mono">1.5k - 2.5k Words</span></li>
          <li class="flex justify-between"><span>{t('counter.platform.seoTitle')}</span> <span class="text-slate-700 dark:text-slate-200 font-mono">50 - 60 Chars</span></li>
        </ul>
      </div>
      <div class="bg-slate-50 dark:bg-slate-800/20 p-6 rounded-xl border border-slate-200 dark:border-slate-700/30 shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="text-purple-500 dark:text-purple-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          <h3 class="text-slate-700 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">{t('counter.academic')}</h3>
        </div>
        <ul class="text-sm text-slate-500 dark:text-slate-400 space-y-2">
          <li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>{t('counter.standardEssay')}</span> <span class="text-slate-700 dark:text-slate-200 font-mono">500 - 2k Words</span></li>
          <li class="flex justify-between border-b border-slate-200 dark:border-slate-700/30 pb-1"><span>{t('counter.dissertation')}</span> <span class="text-slate-700 dark:text-slate-200 font-mono">10k+ Words</span></li>
          <li class="flex justify-between"><span>{t('counter.abstract')}</span> <span class="text-slate-700 dark:text-slate-200 font-mono">150 - 250 Words</span></li>
        </ul>
      </div>
    </section>

    <!-- Product Overview Section -->
    <section id="features" class="mt-24 py-12 border-y border-slate-200 dark:border-slate-800/50">
      <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6">
          {t('features.title')}
        </h2>
        <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed mb-12">
          {t('features.subtitle')}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-left">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 dark:bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <h4 class="text-slate-900 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">
              {t('features.1.title')}
            </h4>
            <p class="text-slate-500 dark:text-slate-500 text-sm leading-relaxed">
              {t('features.1.desc')}
            </p>
          </div>
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 dark:bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h4 class="text-slate-900 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">
              {t('features.2.title')}
            </h4>
            <p class="text-slate-500 dark:text-slate-500 text-sm leading-relaxed">
              {t('features.2.desc')}
            </p>
          </div>
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-purple-500/10 dark:bg-purple-500/10 flex items-center justify-center text-purple-600 dark:text-purple-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h4 class="text-slate-900 dark:text-slate-200 font-bold uppercase text-xs tracking-widest">
              {t('features.3.title')}
            </h4>
            <p class="text-slate-500 dark:text-slate-500 text-sm leading-relaxed">
              {t('features.3.desc')}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="mt-20 pt-12 border-t border-slate-200 dark:border-slate-800 max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8 text-center">
        {t('faq.title')}
      </h2>
      <div class="space-y-6">
        <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
          <h3 class="text-lg font-semibold text-blue-600 dark:text-blue-400 mb-2">{t('faq.q1')}</h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('faq.a1')}
          </p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
          <h3 class="text-lg font-semibold text-emerald-600 dark:text-emerald-400 mb-2">{t('faq.q2')}</h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('faq.a2')}
          </p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
          <h3 class="text-lg font-semibold text-purple-600 dark:text-purple-400 mb-2">{t('faq.q3')}</h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('faq.a3')}
          </p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
          <h3 class="text-lg font-semibold text-blue-600 dark:text-blue-400 mb-2">{t('faq.q4')}</h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('faq.a4')}
          </p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
          <h3 class="text-lg font-semibold text-emerald-600 dark:text-emerald-400 mb-2">{t('faq.q5')}</h3>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('faq.a5')}
          </p>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800/30 p-6 rounded-xl border border-slate-200 dark:border-slate-700/50 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-700 dark:text-slate-200 mb-2">{t('faq.q6')}</h3>
