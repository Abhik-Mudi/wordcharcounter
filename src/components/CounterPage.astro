              {t('seo.c5.desc')}
            </p>
          </div>

          <!-- Card 6 (Conclusion) -->
          <div class="p-8 bg-gradient-to-br from-blue-600 to-emerald-600 dark:from-blue-500/20 dark:to-emerald-500/20 border border-blue-500/20 dark:border-emerald-500/20 rounded-3xl flex flex-col justify-center">
            <h3 class="text-xl font-bold text-white mb-4">
              {t('seo.c6.title')}
            </h3>
            <p class="text-blue-50 dark:text-slate-300 text-sm leading-relaxed mb-6">
              {t('seo.c6.desc')}
            </p>
            <a href="#text-input" class="inline-flex items-center gap-2 text-white font-bold text-sm hover:gap-3 transition-all">
              {t('seo.c6.cta')}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<script>
  // Read localized values from container data attributes
  const container = document.getElementById('counter-container');
  const copiedSuccessText = container?.getAttribute('data-copied') || 'Copied!';
  const enterTextKeywordsText = container?.getAttribute('data-enter-keywords') || 'Enter text to see keyword analysis...';
  const noKeywordsText = container?.getAttribute('data-no-keywords') || 'No significant keywords found.';
  const enterTextFreqText = container?.getAttribute('data-enter-freq') || 'Enter text to see frequency...';
  const spaceText = container?.getAttribute('data-space') || 'Space';
  const overLimitText = container?.getAttribute('data-over-limit') || 'Over Limit';
  const warningText = container?.getAttribute('data-warning') || 'Warning';
  const goodText = container?.getAttribute('data-good') || 'Good';
  const activeLang = container?.getAttribute('data-lang') || 'en';

  const textarea = document.getElementById('text-input') as HTMLTextAreaElement;
  const wordCountEl = document.getElementById('word-count');
  const charCountEl = document.getElementById('char-count');
  const uniqueCharCountEl = document.getElementById('unique-char-count');
  const charNoSpacesEl = document.getElementById('char-no-spaces');
  const sentenceCountEl = document.getElementById('sentence-count');
  const paragraphCountEl = document.getElementById('paragraph-count');
  const readingTimeEl = document.getElementById('reading-time');
  const speakingTimeEl = document.getElementById('speaking-time');
  const keywordListEl = document.getElementById('keyword-list');
  const charFreqListEl = document.getElementById('char-freq-list');
  
  const copyBtn = document.getElementById('copy-btn');
  const clearBtn = document.getElementById('clear-btn');

  // Platform Validation Elements
  const platformBtns = document.querySelectorAll('.platform-btn');
  const progressContainer = document.getElementById('progress-container');
  const progressBar = document.getElementById('progress-bar');
  const platformNameEl = document.getElementById('platform-name');
  const limitBadge = document.getElementById('limit-badge');
  const currentCharCountEl = document.getElementById('current-char-count');
  const maxCharLimitEl = document.getElementById('max-char-limit');

  let currentLimit = 0;
  let currentPlatform = 'None';

  // Localized Stop Words
  const STOP_WORDS_MAP: Record<string, Set<string>> = {
    en: new Set(["the", "and", "a", "to", "is", "of", "in", "it", "you", "that", "he", "was", "for", "on", "are", "as", "with", "his", "they", "i", "at", "be", "this", "have", "from", "or", "one", "had", "by", "word", "but", "not", "what", "all", "were", "we", "when", "your", "can", "said", "there", "use", "an", "each", "which", "she", "do", "how", "their", "if", "will", "up", "other", "about", "out", "many", "then", "them", "these", "so", "some", "her", "would", "make", "like", "him", "into", "time", "has", "look", "two", "more", "write", "go", "see", "number", "no", "way", "could", "my", "than", "first", "been", "call", "who", "its", "now", "find"]),
    de: new Set(["der", "die", "das", "und", "ist", "in", "zu", "den", "von", "mit", "sich", "auf", "für", "eine", "einer", "ein", "dem", "des", "einem", "einen", "aus", "nach", "im", "bei", "oder", "aber", "auch", "wie", "als", "um", "wir", "ihr", "sie", "es", "ich", "er", "wir", "nur", "noch", "ist", "sind", "war", "waren", "haben", "hat", "eine", "einem", "einen"]),
    fr: new Set(["le", "la", "les", "et", "un", "une", "des", "de", "en", "dans", "par", "pour", "qui", "que", "quoi", "dont", "ou", "mais", "donc", "or", "ni", "car", "sur", "avec", "dans", "chez", "sous", "vers", "elle", "il", "ils", "elles", "je", "tu", "nous", "vous", "on", "se", "sa", "son", "ses", "leur", "leurs", "ce", "cet", "cette", "ces"]),
    es: new Set(["el", "la", "los", "las", "y", "un", "una", "unos", "unas", "de", "en", "por", "para", "que", "como", "con", "sin", "sobre", "entre", "hasta", "desde", "yo", "tu", "el", "ella", "nosotros", "vosotros", "ellos", "ellas", "este", "esta", "estos", "estas", "ese", "esa", "esos", "esas", "mi", "tu", "su", "mis", "tus", "sus"]),
    pt: new Set(["o", "a", "os", "as", "e", "um", "uma", "uns", "umas", "de", "em", "por", "para", "que", "como", "com", "sem", "sobre", "entre", "ate", "desde", "eu", "tu", "ele", "ela", "nosos", "vos", "eles", "elas", "este", "esta", "estes", "estas", "esse", "essa", "esses", "essas", "meu", "teu", "seu", "meus", "teus", "seus"]),
    nl: new Set(["de", "het", "een", "en", "van", "in", "op", "met", "voor", "door", "te", "om", "als", "is", "zijn", "was", "waren", "hebben", "heeft", "had", "hadden", "ik", "jij", "hij", "zij", "wij", "jullie", "ze", "het", "me", "je", "hem", "haar", "ons", "hun", "deze", "dit", "die", "dat"])
  };
  const STOP_WORDS = STOP_WORDS_MAP[activeLang] || STOP_WORDS_MAP.en;

  function formatTime(totalSeconds: number): string {
    if (totalSeconds === 0) return '0s';
    
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = Math.round(totalSeconds % 60);

    const parts = [];
    if (h > 0) parts.push(`${h}h`);
    if (m > 0) parts.push(`${m}m`);
    if (s > 0 || (h === 0 && m === 0)) parts.push(`${s}s`);
    
    return parts.join(' ');
  }

  function updatePlatformUI() {
    if (currentLimit === 0) {
      progressContainer?.classList.add('hidden');
      textarea.classList.remove('ring-rose-500/50', 'ring-2');
      return;
    }

    progressContainer?.classList.remove('hidden');
    platformNameEl!.textContent = currentPlatform;
    maxCharLimitEl!.textContent = currentLimit.toLocaleString();
    
    const textLength = textarea.value.length;
    currentCharCountEl!.textContent = textLength.toLocaleString();
    
    const percentage = Math.min((textLength / currentLimit) * 100, 100);
    progressBar!.style.width = `${percentage}%`;

    // Update Colors and Badges
    limitBadge!.classList.remove('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-500/20', 'bg-amber-500/10', 'text-amber-600', 'dark:text-amber-400', 'border-amber-500/20', 'bg-rose-500/10', 'text-rose-600', 'dark:text-rose-400', 'border-rose-500/20');
    progressBar!.classList.remove('bg-blue-500', 'bg-amber-500', 'bg-rose-500');
    textarea.classList.remove('ring-rose-500/50', 'ring-2');

    if (textLength > currentLimit) {
      limitBadge!.textContent = overLimitText;
      limitBadge!.classList.add('bg-rose-500/10', 'text-rose-600', 'dark:text-rose-400', 'border-rose-500/20');
      progressBar!.classList.add('bg-rose-500');
      textarea.classList.add('ring-rose-500/50', 'ring-2');
    } else if (textLength > currentLimit * 0.8) {
      limitBadge!.textContent = warningText;
      limitBadge!.classList.add('bg-amber-500/10', 'text-amber-600', 'dark:text-amber-400', 'border-amber-500/20');
      progressBar!.classList.add('bg-amber-500');
    } else {
      limitBadge!.textContent = goodText;
      limitBadge!.classList.add('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-500/20');
      progressBar!.classList.add('bg-blue-500');
    }
  }

  function updateMetrics() {
    const text = textarea.value;
    
    // Word Count
    const words = text.trim().split(/\s+/).filter(word => word.length > 0);
    const wordCount = words.length;
    wordCountEl!.textContent = wordCount.toLocaleString();

    // Character Counts
    charCountEl!.textContent = text.length.toLocaleString();
    charNoSpacesEl!.textContent = text.replace(/\s/g, '').length.toLocaleString();

    // Unique Character Count
    const uniqueChars = new Set(text).size;
    uniqueCharCountEl!.textContent = uniqueChars.toLocaleString();

    // Sentence Count
    const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0);
    sentenceCountEl!.textContent = sentences.length.toLocaleString();

    // Paragraph Count
    const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);
    paragraphCountEl!.textContent = paragraphs.length.toLocaleString();

    // Reading/Speaking Time
    const readSeconds = (wordCount / 225) * 60;
    const speakSeconds = (wordCount / 130) * 60;
    readingTimeEl!.textContent = formatTime(readSeconds);
    speakingTimeEl!.textContent = formatTime(speakSeconds);

    // Analysis Updates
    updateKeywords(words);
    updateCharacterFrequency(text);
    updatePlatformUI();
  }

  // Platform Button Clicks
  platformBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state
      platformBtns.forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-700');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-700');

      currentLimit = parseInt(btn.getAttribute('data-limit') || '0');
      currentPlatform = btn.textContent?.trim() || 'None';
      updatePlatformUI();
    });
  });

  function updateKeywords(words: string[]) {
    if (words.length === 0) {
      keywordListEl!.innerHTML = `<p class="text-xs text-slate-500 italic">${enterTextKeywordsText}</p>`;
      return;
    }

    const counts: Record<string, number> = {};
    words.forEach(word => {
      const cleanWord = word.toLowerCase().replace(/[^\w]/g, '');
      if (cleanWord.length > 2 && !STOP_WORDS.has(cleanWord)) {
        counts[cleanWord] = (counts[cleanWord] || 0) + 1;
      }
    });

    const sortedKeywords = Object.entries(counts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 8);

    if (sortedKeywords.length === 0) {
      keywordListEl!.innerHTML = `<p class="text-xs text-slate-500 italic">${noKeywordsText}</p>`;
      return;
    }

    keywordListEl!.innerHTML = sortedKeywords.map(([word, count]) => {
      const percentage = ((count / words.length) * 100).toFixed(1);
      return `
        <div class="flex justify-between items-center text-sm">
          <span class="text-slate-700 dark:text-slate-300 font-medium truncate max-w-[100px]" title="${word}">${word}</span>
          <div class="flex items-center gap-3 flex-1 justify-end">
            <div class="h-1.5 w-20 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden hidden sm:block">
              <div class="h-full bg-blue-500" style="width: ${Math.min(parseFloat(percentage) * 5, 100)}%"></div>
            </div>
            <div class="flex gap-2 min-w-[70px] justify-end">
              <span class="text-blue-600 dark:text-blue-400 font-mono text-xs">${percentage}%</span>
              <span class="text-slate-500 text-xs">(${count})</span>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function updateCharacterFrequency(text: string) {
    if (text.length === 0) {
      charFreqListEl!.innerHTML = `<p class="text-xs text-slate-500 italic col-span-full">${enterTextFreqText}</p>`;
      return;
    }

    const counts: Record<string, number> = {};
    for (const char of text) {
      counts[char] = (counts[char] || 0) + 1;
    }

    const totalChars = text.length;
    const sortedChars = Object.entries(counts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 24);

    charFreqListEl!.innerHTML = sortedChars.map(([char, count]) => {
      let displayChar = char;
      if (char === ' ') displayChar = spaceText;
      if (char === '\n') displayChar = '↵';
      if (char === '\t') displayChar = '⇥';
      
      const percentage = ((count / totalChars) * 100).toFixed(1);

      return `
        <div class="flex flex-col items-center p-2 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700/50 rounded text-[10px] shadow-sm">
          <span class="text-slate-600 dark:text-slate-400 font-mono mb-1 truncate w-full text-center" title="${displayChar}">${displayChar}</span>
          <span class="text-blue-600 dark:text-blue-400 font-bold">${count}</span>
          <span class="text-slate-400 dark:text-slate-500 text-[8px] mt-0.5">${percentage}%</span>
        </div>
      `;
    }).join('');
  }

  textarea.addEventListener('input', updateMetrics);

  copyBtn?.addEventListener('click', () => {
    const originalContent = copyBtn.querySelector('span')!.innerHTML;
    navigator.clipboard.writeText(textarea.value).then(() => {
      copyBtn.querySelector('span')!.innerHTML = copiedSuccessText;
      setTimeout(() => copyBtn.querySelector('span')!.innerHTML = originalContent, 2000);
    });
  });

  clearBtn?.addEventListener('click', () => {
    textarea.value = '';
    updateMetrics();
  });

  // Initialize
  updateMetrics();
</script>

<style>
