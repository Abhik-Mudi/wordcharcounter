---
import "../styles/global.css";
import { useTranslations } from '../i18n/utils';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title?: string;
  description?: string;
}

const lang = Astro.currentLocale || "en";
const t = useTranslations(lang);

const {
  title = t('counter.metaTitle'),
  description = t('counter.metaDesc'),
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://wordcharcounter.com",
);

const locales = ['en', 'de', 'fr', 'es', 'pt', 'nl'];

// Parse current relative path (without locale prefix)
let currentPath = Astro.url.pathname;
const pathParts = currentPath.split('/').filter(Boolean);
if (pathParts.length > 0 && locales.includes(pathParts[0])) {
  pathParts.shift(); // Remove the locale prefix
}
const relativePath = pathParts.join('/');

// Keywords for SEO schema
const keywordsMap: Record<string, string> = {
  en: "word counter, character counter, word & character counter, word counter free, character counter online, twitter character counter",
  de: "wortzähler, zeichenzähler, wort und zeichenzähler, wortzähler kostenlos, zeichenzähler online, twitter zeichenzähler",
  fr: "compteur de mots, compteur de caracteres, compteur de mots gratuit, compteur de caracteres en ligne, twitter compteur de caracteres",
  es: "contador de palabras, contador de caracteres, contador de palabras gratis, contador de caracteres online, twitter contador de caracteres",
  pt: "contador de palavras, contador de caracteres, contador de palavras gratis, contador de caracteres online, twitter contador de caracteres",
  nl: "woordenteller, tekenteller, woord en tekenteller, woordenteller gratis, tekenteller online, twitter tekenteller",
};
const currentKeywords = keywordsMap[lang] || keywordsMap.en;

const getLocalizedPath = (targetLocale: string) => {
  return getRelativeLocaleUrl(targetLocale, relativePath);
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: t('counter.title'),
      url: "https://wordcharcounter.com",
      operatingSystem: "Any",
      applicationCategory: "UtilitiesApplication",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      description: description,
      keywords: currentKeywords,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: t('faq.q1'),
          acceptedAnswer: {
            "@type": "Answer",
            text: t('faq.a1'),
          },
        },
        {
          "@type": "Question",
          name: t('faq.q2'),
          acceptedAnswer: {
            "@type": "Answer",
            text: t('faq.a2'),
          },
        },
        {
          "@type": "Question",
          name: t('faq.q3'),
          acceptedAnswer: {
            "@type": "Answer",
            text: t('faq.a3'),
          },
        },
        {
          "@type": "Question",
          name: t('faq.q4'),
          acceptedAnswer: {
            "@type": "Answer",
            text: t('faq.a4'),
          },
        },
        {
          "@type": "Question",
          name: t('faq.q5'),
          acceptedAnswer: {
            "@type": "Answer",
            text: t('faq.a5'),
          },
        },
        {
          "@type": "Question",
          name: t('faq.q6'),
          acceptedAnswer: {
            "@type": "Answer",
            text: t('faq.a6'),
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-04JEQSG424"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());

			gtag('config', 'G-04JEQSG424');
		</script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang markup for each language -->
    {locales.map((locale) => (
      <link rel="alternate" hreflang={locale} href={getAbsoluteLocaleUrl(locale, relativePath)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', relativePath)} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href="/favicon.ico"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-200 transition-colors duration-300">
    <!-- Navbar -->
    <nav
      class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800"
    >
      <div
        class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between"
      >
        <a href={getRelativeLocaleUrl(lang, "")} class="flex items-center gap-2 group">
          <img
            src="/favicon.svg"
            alt="Logo"
            class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-emerald-500 flex items-center justify-center text-white font-bold shadow-lg shadow-blue-500/20 group-hover:shadow-blue-500/40 transition-shadow"
          />
          <span
            class="text-slate-900 dark:text-white font-bold text-lg tracking-tight hidden sm:block"
            >Word & Character <span class="text-blue-500 dark:text-blue-400">Counter</span></span
          >
        </a>

				<div class="flex items-center gap-3 sm:gap-4 md:gap-6">
          <!-- Language Selector -->
          <div class="relative flex items-center group">
            <div class="absolute left-2.5 pointer-events-none text-slate-500 dark:text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <select
              id="lang-select"
              class="appearance-none bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-lg py-1.5 pl-8 pr-7 text-xs font-semibold focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer hover:bg-slate-200 dark:hover:bg-slate-700 transition-all shadow-sm"
              aria-label="Change Language"
            >
              <option value={getLocalizedPath('en')} selected={lang === 'en'}>English</option>
              <option value={getLocalizedPath('de')} selected={lang === 'de'}>Deutsch</option>
              <option value={getLocalizedPath('fr')} selected={lang === 'fr'}>Français</option>
              <option value={getLocalizedPath('es')} selected={lang === 'es'}>Español</option>
              <option value={getLocalizedPath('pt')} selected={lang === 'pt'}>Português</option>
              <option value={getLocalizedPath('nl')} selected={lang === 'nl'}>Nederlands</option>
            </select>
            <div class="absolute right-2 pointer-events-none text-slate-500 dark:text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-2.5 h-2.5"><path d="m6 9 6 6 6-6"/></svg>
            </div>
          </div>

					<button 
						id="theme-toggle"
						class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-all shadow-sm"
						aria-label="Toggle Theme"
					>
						<svg id="sun-icon" class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
						<svg id="moon-icon" class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
					</button>
					<a href={getRelativeLocaleUrl(lang, "") + "#features"} class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">{t('nav.features')}</a>
					<a href={getRelativeLocaleUrl(lang, "about")} class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">{t('nav.about')}</a>
					<a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">{t('nav.faq')}</a>
					<a href={getRelativeLocaleUrl(lang, "contact")} class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">{t('nav.contact')}</a>
				</div>
      </div>
    </nav>

    <slot />

    <!-- Footer -->
    <footer class="mt-auto bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 pt-16 pb-8">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
          <div class="md:col-span-1 space-y-4">
            <a href={getRelativeLocaleUrl(lang, "")} class="flex items-center gap-2">
              <img
                src="/favicon.svg"
                alt="Logo"
                class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-emerald-500 flex items-center justify-center text-white font-bold shadow-lg shadow-blue-500/20"
              />
              <span class="text-slate-900 dark:text-white font-bold text-lg tracking-tight"
                >Word & Character <span class="text-blue-500 dark:text-blue-400">Counter</span></span
              >
            </a>
            <p class="text-slate-600 dark:text-slate-500 text-sm leading-relaxed">
              {t('footer.desc')}
            </p>
          </div>

					<div>
						<h4
							class="text-slate-900 dark:text-white font-bold text-sm uppercase tracking-widest mb-6"
						>
							{t('footer.product')}
						</h4>
						<ul class="space-y-4 text-sm text-slate-600 dark:text-slate-500">
							<li>
								<a href={getRelativeLocaleUrl(lang, "")} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>{t('footer.product.wordCounter')}</a>
							</li>
							<li>
								<a href={getRelativeLocaleUrl(lang, "about")} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>{t('footer.product.about')}</a>
							</li>
							<li>
								<a href={getRelativeLocaleUrl(lang, "contact")} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>{t('footer.product.contact')}</a>
							</li>
						</ul>
					</div>

					<div>
						<h4
							class="text-slate-900 dark:text-white font-bold text-sm uppercase tracking-widest mb-6"
						>
							{t('footer.resources')}
						</h4>
						<ul class="space-y-4 text-sm text-slate-600 dark:text-slate-500">
							<li>
								<a href={getRelativeLocaleUrl(lang, "") + "#features"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>{t('footer.resources.tips')}</a>
							</li>
							<li>
								<a href={getRelativeLocaleUrl(lang, "") + "#faq"} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>{t('footer.resources.faq')}</a>
							</li>
						</ul>
					</div>

					<div>
						<h4
							class="text-slate-900 dark:text-white font-bold text-sm uppercase tracking-widest mb-6"
						>
							{t('footer.legal')}
						</h4>
						<ul class="space-y-4 text-sm text-slate-600 dark:text-slate-500">
							<li>
								<a href={getRelativeLocaleUrl(lang, "privacy-policy")} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>{t('footer.legal.privacy')}</a>
							</li>
							<li>
								<a href={getRelativeLocaleUrl(lang, "terms")} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>{t('footer.legal.terms')}</a>
							</li>
						</ul>
					</div>
        </div>

        <div
          class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-slate-200 dark:border-slate-800 gap-4"
        >
          <p class="text-slate-500 text-xs">
            &copy; {new Date().getFullYear()} {t('footer.rights')}
          </p>
          <div class="flex items-center gap-6">
            <a
              href="#"
              class="text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-white transition-colors"
              aria-label="Twitter"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path
                  d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
                ></path></svg
              >
            </a>
            <a
              href="#"
              class="text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-white transition-colors"
              aria-label="GitHub"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path
                  d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	
	themeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	});

  const langSelect = document.getElementById('lang-select') as HTMLSelectElement;
  langSelect?.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    if (target.value) {
      window.location.href = target.value;
    }
  });
</script>
