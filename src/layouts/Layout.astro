---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Word & Character Counter - Free Online Writing Tool",
  description = "Use our free Word & Character Counter online tool to track word count, character count, and keyword density in real-time. Perfect for essays, Twitter (X), LinkedIn, and Instagram posts.",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://wordcharactercounter.com",
);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Word & Character Counter - Free Tool",
      operatingSystem: "Any",
      applicationCategory: "UtilitiesApplication",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      description:
        "Professional-grade Word & Character Counter free tool. Get instant metrics for word count, character counter online, and keyword density. Perfect for essays, blog posts, and social media.",
      keywords:
        "word counter, character counter, word & character counter, word counter free, character counter online, twitter character counter",
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is Word & Character Counter free to use?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes, our Word & Character Counter is 100% free to use. There are no hidden fees, subscriptions, or limits on how much text you can analyze.",
          },
        },
        {
          "@type": "Question",
          name: "Is my data safe? Does the tool store my text?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Your privacy is our priority. All calculations and text analysis are performed locally within your web browser. We never send your text to any server, and we do not store any of your content.",
          },
        },
        {
          "@type": "Question",
          name: "How does the Twitter (X) character counter work?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Our tool functions as a real-time Twitter character counter. Since X (Twitter) has a 280-character limit, you can monitor your character count as you type to ensure your post fits perfectly without being truncated.",
          },
        },
        {
          "@type": "Question",
          name: "Can I use this as an essay word counter?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Absolutely. It is an ideal essay word counter for students and academics. It provides accurate word counts, character counts (with and without spaces), and sentence tracking to help you meet strict assignment requirements.",
          },
        },
        {
          "@type": "Question",
          name: "How is keyword density calculated?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Keyword density is calculated by dividing the number of times a specific word appears by the total number of words in the text. We filter out common 'stop words' (like 'the', 'is', 'at') to show you the most meaningful keywords.",
          },
        },
        {
          "@type": "Question",
          name: "What is the average reading speed used for the time calculator?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "The reading time is calculated using a standard average speed of 225 words per minute, which is the typical rate for an adult reading non-technical content.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>

		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-04JEQSG424"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());

			gtag('config', 'G-04JEQSG424');
		</script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link
      rel="icon"
      type="image/x-icon"
      sizes="16x16 32x32 48x48"
      href="favicon.ico"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-200 transition-colors duration-300">
    <!-- Navbar -->
    <nav
      class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800"
    >
      <div
        class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between"
      >
        <a href="/" class="flex items-center gap-2 group">
          <img
            src="/favicon.svg"
            alt="Logo"
            class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-emerald-500 flex items-center justify-center text-white font-bold shadow-lg shadow-blue-500/20 group-hover:shadow-blue-500/40 transition-shadow"
          />
          <span
            class="text-slate-900 dark:text-white font-bold text-lg tracking-tight hidden sm:block"
            >Word & Character <span class="text-blue-500 dark:text-blue-400">Counter</span></span
          >
        </a>

				<div class="flex items-center gap-4 sm:gap-6">
					<button 
						id="theme-toggle"
						class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-all shadow-sm"
						aria-label="Toggle Theme"
					>
						<svg id="sun-icon" class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
						<svg id="moon-icon" class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
					</button>
					<a href="/#features" class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">Features</a>
					<a href="/about" class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">About</a>
					<a href="/#faq" class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">FAQ</a>
					<a href="/contact" class="text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-white transition-colors">Contact</a>
				</div>
      </div>
    </nav>

    <slot />

    <!-- Footer -->
    <footer class="mt-auto bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 pt-16 pb-8">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
          <div class="md:col-span-1 space-y-4">
            <a href="/" class="flex items-center gap-2">
              <img
                src="/favicon.svg"
                alt="Logo"
                class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-emerald-500 flex items-center justify-center text-white font-bold shadow-lg shadow-blue-500/20"
              />
              <span class="text-slate-900 dark:text-white font-bold text-lg tracking-tight"
                >Word & Character <span class="text-blue-500 dark:text-blue-400">Counter</span></span
              >
            </a>
            <p class="text-slate-600 dark:text-slate-500 text-sm leading-relaxed">
              The most advanced word counting tool for writers, editors, and SEO
              professionals. Real-time metrics and deep text analysis.
            </p>
          </div>

					<div>
						<h4
							class="text-slate-900 dark:text-white font-bold text-sm uppercase tracking-widest mb-6"
						>
							Product
						</h4>
						<ul class="space-y-4 text-sm text-slate-600 dark:text-slate-500">
							<li>
								<a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>Word Counter</a>
							</li>
							<li>
								<a href="/about" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>About Us</a>
							</li>
							<li>
								<a href="/contact" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>Contact Us</a>
							</li>
						</ul>
					</div>

					<div>
						<h4
							class="text-slate-900 dark:text-white font-bold text-sm uppercase tracking-widest mb-6"
						>
							Resources
						</h4>
						<ul class="space-y-4 text-sm text-slate-600 dark:text-slate-500">
							<li>
								<a href="/#features" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>Features</a>
							</li>
							<li>
								<a href="/#guidelines" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>Writing Tips</a>
							</li>
							<li>
								<a href="/#faq" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>Help Center (FAQ)</a>
							</li>
						</ul>
					</div>

					<div>
						<h4
							class="text-slate-900 dark:text-white font-bold text-sm uppercase tracking-widest mb-6"
						>
							Legal
						</h4>
						<ul class="space-y-4 text-sm text-slate-600 dark:text-slate-500">
							<li>
								<a href="/privacy-policy" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>Privacy Policy</a>
							</li>
							<li>
								<a href="/terms" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
									>Terms of Service</a>
							</li>
						</ul>
					</div>
        </div>

        <div
          class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-slate-200 dark:border-slate-800 gap-4"
        >
          <p class="text-slate-500 text-xs">
            &copy; {new Date().getFullYear()} Word & Character Counter. All rights reserved.
            Built with Astro & Tailwind.
          </p>
          <div class="flex items-center gap-6">
            <a
              href="#"
              class="text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-white transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path
                  d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
                ></path></svg
              >
            </a>
            <a
              href="#"
              class="text-slate-400 dark:text-slate-500 hover:text-blue-600 dark:hover:text-white transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path
                  d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	
	themeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	});
</script>
